# Copiar a .env y completar. .env no se sube al repo.
DOMAIN=fraude
MAX_TURNS=10

# Sesión 1 (mock): tal cual, con `uv run python dev/mock_foundry.py` en otra terminal
# Sesión 2 (Foundry): Overview del recurso > Endpoint y Keys
#   FOUNDRY_ENDPOINT=https://<tu-recurso>.openai.azure.com
#   FOUNDRY_API_KEY=<key del recurso>
FOUNDRY_ENDPOINT=http://127.0.0.1:8100
FOUNDRY_DEPLOYMENT=gpt-5-mini

# Provider de autenticación contra Foundry: api_key | entra_id
#   api_key  -> usa FOUNDRY_API_KEY
#   entra_id -> DefaultAzureCredential (az login en local, Managed Identity desplegado);
#               requiere rol "Cognitive Services OpenAI User" en el recurso
FOUNDRY_AUTH_PROVIDER=api_key
FOUNDRY_API_KEY=fake-token

FOUNDRY_TIMEOUT_S=30
FOUNDRY_MAX_RETRIES=2
